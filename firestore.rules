rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 真正登入的帳號（排除匿名）。匿名 token 是給未登入訪客用免費額度用的，
    // uid 可拋棄，不該能寫入公開的分享內容。
    function isRealUser() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isFeatureRequestAdmin() {
      return isRealUser()
             && request.auth.token.keys().hasAll(['email', 'email_verified'])
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'voho0000@gmail.com';
    }

    function ownsFeatureRequest(requestId) {
      return isRealUser()
             && exists(/databases/$(database)/documents/featureRequestOwners/$(requestId))
             && get(/databases/$(database)/documents/featureRequestOwners/$(requestId)).data.authorId == request.auth.uid;
    }

    function validFeatureRequestStatus(status) {
      return status in ['evaluating', 'planned', 'in-progress', 'completed'];
    }

    function validFeatureRequestCategory(category) {
      return category in ['ai', 'feature', 'ui'];
    }

    function validFeatureRequestContent(data) {
      return data.title is string
             && data.title.size() >= 2
             && data.title.size() <= 100
             && data.description is string
             && data.description.size() <= 1200
             && validFeatureRequestCategory(data.category)
             && data.displayAuthor is bool
             && data.authorName is string
             && data.authorName.size() <= 100
             && (!data.displayAuthor || data.authorName.size() >= 1);
    }

    function validFeatureRequestVisibility(data) {
      return (data.visibility == 'visible'
                && data.hiddenReason == ''
                && data.hiddenBy == '')
             || (data.visibility == 'hidden'
                && data.hiddenReason in ['withdrawn', 'moderated']
                && data.hiddenBy in ['author', 'admin']);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Canonical tenant/role authority. Clients may read only their own
      // memberships to select an active workspace. Only Admin SDK / the
      // membership management Function may write or disable these records.
      match /memberships/{tenantId} {
        allow read: if isRealUser() && request.auth.uid == userId;
        allow write: if false;
      }
      
      // 每日額度計數由代理 Cloud Functions 以 Admin SDK 寫入（Admin SDK 會略過
      // 規則）。client 只讀取以顯示剩餘額度，不可寫入，讓計量維持伺服器端為準。
      match /usage/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      
      match /chatTemplates/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /clinicalInsightPanels/{panelId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 我的最愛：每筆是使用者自己的一份範本副本（不是參照），只有本人可讀寫。
      match /promptFavorites/{promptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    function validSharedPrompt(data) {
      return data.keys().hasAll(['title', 'prompt', 'types', 'category', 'specialty', 'audience',
                                'tags', 'authorId', 'usageCount', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['title', 'description', 'prompt', 'types', 'category', 'specialty',
                 'audience', 'tags', 'authorId', 'authorName', 'isAnonymous', 'usageCount',
                 'createdAt', 'updatedAt', 'outputFormat', 'languagePolicy', 'body', 'exampleOutput', 'tenantId', 'isPublic', 'version'])
             && (!('exampleOutput' in data) || (data.exampleOutput is string && data.exampleOutput.size() <= 20000))
             && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128))
             && data.title is string && data.title.size() > 0 && data.title.size() <= 100
             && data.prompt is string && data.prompt.size() > 0
             && data.get('description', '') is string && data.get('description', '').size() <= 180
             && data.types is list && data.types.size() > 0 && data.types.size() <= 2
             && data.types.hasOnly(['chat', 'summary'])
             && data.category in ['soap', 'admission', 'discharge', 'safety', 'summary', 'progress', 'consult', 'procedure', 'other']
             && data.specialty is list && data.specialty.size() <= 37
             && data.specialty.hasOnly(['general', 'internal', 'cardiology', 'gastroenterology', 'pulmonology',
                 'nephrology', 'rheumatology', 'immunology', 'hematology', 'medical_oncology', 'endocrinology',
                 'infectious_diseases', 'surgery', 'neurosurgery', 'emergency', 'critical_care', 'pediatrics',
                 'obstetrics', 'psychiatry', 'neurology', 'rehabilitation', 'anesthesiology', 'ophthalmology',
                 'dermatology', 'urology', 'orthopedics', 'ent', 'radiology', 'radiation_oncology', 'pathology',
                 'anatomic_pathology', 'clinical_pathology', 'nuclear_medicine', 'plastic_surgery',
                 'family_medicine', 'occupational_medicine', 'other'])
             && data.audience is list && data.audience.size() > 0 && data.audience.size() <= 2
             && data.audience.hasOnly(['medical', 'patient'])
             && data.tags is list && data.tags.size() <= 8
             && validTag(data.tags, 0) && validTag(data.tags, 1) && validTag(data.tags, 2) && validTag(data.tags, 3)
             && validTag(data.tags, 4) && validTag(data.tags, 5) && validTag(data.tags, 6) && validTag(data.tags, 7)
             && data.authorId is string
             && data.get('authorName', '') is string && data.get('authorName', '').size() <= 100
             && data.get('isAnonymous', false) is bool
             && (!data.get('isAnonymous', false) || !data.keys().hasAny(['authorName']))
             && data.usageCount is int && data.usageCount >= 0
             && data.createdAt is timestamp && data.updatedAt is timestamp
             && data.get('outputFormat', 'markdown') in ['plain-text', 'markdown', 'html']
             && data.get('languagePolicy', 'interface-language') in ['interface-language', 'follow-template']
             && data.get('isPublic', true) is bool
             && data.get('version', 1) is int && data.get('version', 1) >= 1;
    }

    function validTemplateVersionUpdate() {
      let materialChanged = request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['prompt', 'body', 'outputFormat', 'languagePolicy']);
      // Transitional rollout bridge. Firestore Rules cannot identify whether
      // an update came from the old or version-aware app, so a versioned record
      // temporarily accepts the same version for old-client edits as well as
      // an exact +1 for a material version-aware edit. Removal, downgrade and
      // jumps remain forbidden. Tighten this after old app sessions expire.
      return (!resource.data.keys().hasAny(['version']) && !request.resource.data.keys().hasAny(['version']))
        || (request.resource.data.keys().hasAny(['version'])
          && (request.resource.data.version == resource.data.get('version', 1)
            || (materialChanged && request.resource.data.version == resource.data.get('version', 1) + 1)));
    }

    function validTag(tags, index) {
      return tags.size() <= index || (tags[index] is string && tags[index].size() <= 24);
    }

    function validBodyReference(data, promptId) {
      return !data.keys().hasAny(['body']) || (
        data.body is map && data.body.keys().hasOnly(['id', 'chunks', 'length'])
        && data.body.id is string && data.body.chunks is int && data.body.chunks > 0
        && data.body.length is int && data.body.length > 0
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.scope == 'shared'
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.promptId == promptId
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.ready == true
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.chunks == data.body.chunks
        && get(/databases/$(database)/documents/templateBodies/$(data.body.id)).data.length == data.body.length
      );
    }

    match /sharedPrompts/{promptId} {
      allow read: if (resource.data.keys().hasAll(['isPublic']) && resource.data.isPublic == true)
                  || (isRealUser() && request.auth.uid == resource.data.authorId);
      allow create: if isRealUser() && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.usageCount == 0
                    && request.resource.data.get('version', 1) == 1
                    && request.resource.data.keys().hasAll(['isPublic'])
                    && !request.resource.data.keys().hasAny(['tenantId'])
                    && validSharedPrompt(request.resource.data)
                    && validBodyReference(request.resource.data, promptId);
      allow delete: if isRealUser() && request.auth.uid == resource.data.authorId;
      allow update: if isRealUser() && request.auth.uid == resource.data.authorId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'title', 'description', 'prompt', 'types', 'category', 'specialty', 'audience',
                      'tags', 'authorName', 'isAnonymous', 'outputFormat', 'languagePolicy', 'body', 'updatedAt', 'exampleOutput', 'isPublic', 'version'])
                    && validTemplateVersionUpdate()
                    && validSharedPrompt(request.resource.data)
                    && validBodyReference(request.resource.data, promptId);
      // This is the only route for a count change, including for the author.
      allow update: if isRealUser()
                    && ((resource.data.keys().hasAll(['isPublic']) && resource.data.isPublic == true)
                        || request.auth.uid == resource.data.authorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
                    && request.resource.data.usageCount is int
                    && request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    // 科常用範本（tenantPrompts）：只有該科的 active 成員可讀；owner／builder
    // 可發布、編輯、下架。list 查詢必須帶 where('tenantId','==',…) 才能通過規則。
    function activeTenantMember(tenantId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.status == 'active';
    }

    function tenantPublisher(tenantId) {
      return activeTenantMember(tenantId)
             && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(tenantId)).data.role in ['owner', 'builder'];
    }

    match /tenantPrompts/{promptId} {
      allow read: if isRealUser() && activeTenantMember(resource.data.tenantId);
      allow create: if isRealUser()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.usageCount == 0
                    && request.resource.data.get('version', 1) == 1
                    && request.resource.data.keys().hasAll(['tenantId'])
                    && !request.resource.data.keys().hasAny(['body'])
                    && validSharedPrompt(request.resource.data)
                    && tenantPublisher(request.resource.data.tenantId);
      allow delete: if isRealUser() && tenantPublisher(resource.data.tenantId);
      allow update: if isRealUser() && tenantPublisher(resource.data.tenantId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'title', 'description', 'prompt', 'types', 'category', 'specialty', 'audience',
                      'tags', 'authorName', 'isAnonymous', 'outputFormat', 'languagePolicy', 'updatedAt', 'exampleOutput', 'version'])
                    && validTemplateVersionUpdate()
                    && !request.resource.data.keys().hasAny(['body'])
                    && validSharedPrompt(request.resource.data);
      allow update: if isRealUser() && activeTenantMember(resource.data.tenantId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
                    && request.resource.data.usageCount is int
                    && request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    function bodyIsReferencedByShared(data, bodyId) {
      return data.scope == 'shared'
             && exists(/databases/$(database)/documents/sharedPrompts/$(data.promptId))
             && get(/databases/$(database)/documents/sharedPrompts/$(data.promptId)).data.get('body', {}).get('id', '') == bodyId;
    }

    function bodyIsPublished(data, bodyId) {
      return bodyIsReferencedByShared(data, bodyId)
             && get(/databases/$(database)/documents/sharedPrompts/$(data.promptId)).data.isPublic == true;
    }

    // Keep a committed private body intact even if a write acknowledgement was
    // lost and its client attempts failure cleanup.
    function bodyIsReferenced(data, bodyId) {
      return bodyIsReferencedByShared(data, bodyId) || (data.scope == 'private'
             && exists(/databases/$(database)/documents/users/$(data.ownerId)/$(data.collectionName)/$(data.itemId))
             && get(/databases/$(database)/documents/users/$(data.ownerId)/$(data.collectionName)/$(data.itemId)).data.get('textBody', {}).get('id', '') == bodyId);
    }

    function ownsBody(data) {
      return request.auth != null && data.ownerId == request.auth.uid;
    }

    function canReadBody(data, bodyId) {
      return ownsBody(data) || (data.ready == true && bodyIsPublished(data, bodyId));
    }

    // An immutable body is private until a complete parent points to it.
    // Large private chat/summary templates use the same format, scoped to owner.
    match /templateBodies/{bodyId} {
      allow read: if canReadBody(resource.data, bodyId);
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['ownerId', 'scope', 'chunks', 'length', 'ready'])
                    && request.resource.data.keys().hasOnly(['ownerId', 'scope', 'promptId', 'collectionName', 'itemId', 'chunks', 'length', 'ready'])
                    && ownsBody(request.resource.data)
                    && request.resource.data.chunks is int && request.resource.data.chunks > 0
                    && request.resource.data.length is int && request.resource.data.length >= 0
                    && request.resource.data.ready == false
                    && ((request.resource.data.scope == 'private'
                            && request.resource.data.collectionName in ['chatTemplates', 'clinicalInsightPanels']
                            && request.resource.data.itemId is string)
                        || (isRealUser() && request.resource.data.scope == 'shared'
                            && request.resource.data.promptId is string));
      allow update: if ownsBody(resource.data)
                    && resource.data.ready == false && request.resource.data.ready == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
      allow delete: if ownsBody(resource.data) && !bodyIsReferenced(resource.data, bodyId);

      match /chunks/{chunkId} {
        function manifest() {
          return get(/databases/$(database)/documents/templateBodies/$(bodyId)).data;
        }
        allow read: if canReadBody(manifest(), bodyId);
        allow create: if ownsBody(manifest()) && manifest().ready == false
                      && request.resource.data.keys().hasOnly(['index', 'text'])
                      && request.resource.data.index is int && request.resource.data.index >= 0
                      && request.resource.data.index < manifest().chunks
                      && request.resource.data.text is string;
        allow update: if false;
        allow delete: if ownsBody(manifest()) && !bodyIsReferenced(manifest(), bodyId);
      }
    }

    // Public, text-only feature requests. Account ownership and voter records
    // live in separate private collections so anonymous public requests never
    // expose a Firebase uid or email address.
    match /featureRequests/{requestId} {
      allow read: if resource.data.visibility == 'visible'
                  || isFeatureRequestAdmin()
                  || ownsFeatureRequest(requestId);

      allow create: if isRealUser()
                    && request.resource.data.keys().hasOnly([
                      'title', 'description', 'category', 'status',
                      'displayAuthor', 'authorName', 'officialNote',
                      'visibility', 'hiddenReason', 'hiddenBy', 'voteCount',
                      'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll([
                      'title', 'description', 'category', 'status',
                      'displayAuthor', 'authorName', 'officialNote',
                      'visibility', 'hiddenReason', 'hiddenBy', 'voteCount',
                      'createdAt', 'updatedAt'
                    ])
                    && validFeatureRequestContent(request.resource.data)
                    && request.resource.data.status == 'evaluating'
                    && request.resource.data.officialNote == ''
                    && validFeatureRequestVisibility(request.resource.data)
                    && request.resource.data.visibility == 'visible'
                    && request.resource.data.voteCount == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && existsAfter(/databases/$(database)/documents/featureRequestOwners/$(requestId))
                    && getAfter(/databases/$(database)/documents/featureRequestOwners/$(requestId)).data.authorId == request.auth.uid;

      // The author may correct public content only during the first 30 minutes
      // and only before the request leaves the evaluating state.
      allow update: if ownsFeatureRequest(requestId)
                    && resource.data.status == 'evaluating'
                    && resource.data.visibility == 'visible'
                    && request.time <= resource.data.createdAt + duration.value(30, 'm')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'title', 'description', 'category', 'displayAuthor',
                      'authorName', 'updatedAt'
                    ])
                    && validFeatureRequestContent(request.resource.data)
                    && request.resource.data.updatedAt == request.time;

      // Withdrawal is recoverable: it hides the request instead of deleting it.
      allow update: if ownsFeatureRequest(requestId)
                    && resource.data.visibility == 'visible'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'visibility', 'hiddenReason', 'hiddenBy', 'updatedAt'
                    ])
                    && request.resource.data.visibility == 'hidden'
                    && request.resource.data.hiddenReason == 'withdrawn'
                    && request.resource.data.hiddenBy == 'author'
                    && request.resource.data.updatedAt == request.time;

      // A vote count may change only in the same atomic write that creates or
      // removes this user's private vote record.
      allow update: if isRealUser()
                    && resource.data.visibility == 'visible'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
                    && request.resource.data.voteCount is int
                    && request.resource.data.voteCount >= 0
                    && (
                      (request.resource.data.voteCount == resource.data.voteCount + 1
                        && !exists(/databases/$(database)/documents/featureRequestVotes/$(request.auth.uid)/requests/$(requestId))
                        && existsAfter(/databases/$(database)/documents/featureRequestVotes/$(request.auth.uid)/requests/$(requestId)))
                      ||
                      (request.resource.data.voteCount == resource.data.voteCount - 1
                        && exists(/databases/$(database)/documents/featureRequestVotes/$(request.auth.uid)/requests/$(requestId))
                        && !existsAfter(/databases/$(database)/documents/featureRequestVotes/$(request.auth.uid)/requests/$(requestId)))
                    );

      // The single verified owner account may move status, publish an official
      // update, and hide or restore a request. Content and vote totals stay immutable.
      allow update: if isFeatureRequestAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status', 'officialNote', 'visibility', 'hiddenReason',
                      'hiddenBy', 'updatedAt'
                    ])
                    && validFeatureRequestStatus(request.resource.data.status)
                    && request.resource.data.officialNote is string
                    && request.resource.data.officialNote.size() <= 1000
                    && validFeatureRequestVisibility(request.resource.data)
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /featureRequestOwners/{requestId} {
      allow read: if isFeatureRequestAdmin()
                  || (isRealUser() && resource.data.authorId == request.auth.uid);

      allow create: if isRealUser()
                    && request.auth.token.keys().hasAll(['email'])
                    && request.resource.data.keys().hasOnly(['authorId', 'authorEmail', 'createdAt'])
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorEmail == request.auth.token.email
                    && request.resource.data.createdAt == request.time
                    && existsAfter(/databases/$(database)/documents/featureRequests/$(requestId));

      allow update, delete: if false;
    }

    match /featureRequestVotes/{userId}/requests/{requestId} {
      allow read: if isRealUser() && request.auth.uid == userId;

      allow create: if isRealUser()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['requestId', 'userId', 'createdAt'])
                    && request.resource.data.requestId == requestId
                    && request.resource.data.userId == userId
                    && request.resource.data.createdAt == request.time
                    && get(/databases/$(database)/documents/featureRequests/$(requestId)).data.visibility == 'visible'
                    && getAfter(/databases/$(database)/documents/featureRequests/$(requestId)).data.voteCount
                       == get(/databases/$(database)/documents/featureRequests/$(requestId)).data.voteCount + 1;

      allow delete: if isRealUser()
                    && request.auth.uid == userId
                    && getAfter(/databases/$(database)/documents/featureRequests/$(requestId)).data.voteCount
                       == get(/databases/$(database)/documents/featureRequests/$(requestId)).data.voteCount - 1;

      allow update: if false;
    }

    // 由 feedback Function（admin SDK）寫入的防濫用限流桶。admin SDK 會略過
    // 規則，但 client 不該讀寫——明確拒絕以防竄改。
    match /feedbackRateLimits/{doc} {
      allow read, write: if false;
    }

    // Reserved server-governed tenant collections. Reject audit and approved
    // memory are accessed through a trusted service so raw rejection text can
    // never be queried by arbitrary clients or reused as model input.
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if false;
    }
  }
}
