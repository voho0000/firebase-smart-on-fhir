{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "seed:studio:emulator": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-mediprisma node src/services/membership/seed-emulator.mjs",
    "migrate:prompt-visibility": "node scripts/backfill-shared-prompt-visibility.mjs",
    "deploy": "firebase deploy --only functions",
    "deploy:dev": "firebase deploy --only functions:dev",
    "deploy:prod": "firebase deploy --only functions:proxyWhisper,functions:proxyGeminiChat,functions:proxyChatCompletion,functions:proxyPerplexitySearch,functions:proxyClaudeChat,functions:proxyOpenAiCompatibleGateway,functions:sendFeedback",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@ai-sdk/google": "^3.0.5",
    "@ai-sdk/openai": "^3.0.7",
    "ai": "^6.0.14",
    "axios": "^1.7.7",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "form-data": "^4.0.1",
    "resend": "^6.8.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/form-data": "^2.5.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.3"
  },
  "private": true
}
